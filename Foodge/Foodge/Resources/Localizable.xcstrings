    },
    "Foodge never infers this from Health, and never relaxes it to find a match." : {
      "comment" : "A description of the diet preference.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
