      }
    },
    "Foodge reads what Apple Health actually recorded, weighs today against your usual fortnight, and proposes one dinner." : {
      "comment" : "A description of what Foodge does.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foodge lee lo que Apple Salud ha registrado realmente, compara el día de hoy con tus dos últimas semanas y propone una cena."
          }
        }
      }
    },
    "Foodge will ask you about your day instead, and the verdict says so." : {
